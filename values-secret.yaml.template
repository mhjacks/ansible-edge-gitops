---
# NEVER COMMIT THESE VALUES TO GIT
version: "2.0"
secrets:
  - name: vm-ssh
    fields:
    - name: username
      value: 'Username of user to attach privatekey and publickey to - cloud-user is a typical value'

    - name: privatekey
      value: 'Private ssh key of the user who will be able to elevate to root to provision VMs'

    - name: publickey
      value: 'Public ssh key of the user who will be able to elevate to root to provision VMs'

  - name: rhsm
    fields:
    - name: username
      value: 'username of user to register RHEL VMs'
    - name: password
      value: 'password of rhsm user in plaintext'

  - name: cloud-init
    fields:
    - name: userData
      value: |-
        #cloud-config
        user: 'username of user for console, probably cloud-user'
        password: 'a suitable password to use on the console'
        chpasswd: { expire: False }

  # dockerconfigjson used by CDI to pull the Windows golden image
  - name: quay-image-robot
    vaultPrefixes:
    - hub
    fields:
    - name: .dockerconfigjson
      path: 'full pathname of a docker/podman auth.json (or .dockerconfigjson) that can pull quay.io/martjack/*'
